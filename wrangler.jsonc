{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lfms",
  "main": "cloudflare/worker.ts",
  "assets": {
    "directory": "./dist/cloudflare-assets",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true,
  },
  "compatibility_date": "2026-07-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "apiseg.com/*",
      "zone_name": "apiseg.com",
    },
    {
      "pattern": "*.apiseg.com/*",
      "zone_name": "apiseg.com",
    },
  ],
  "containers": [
    {
      "name": "lfms-production-lfmswebcontainer",
      "class_name": "LfmsWebContainer",
      "image": "./Dockerfile",
      "max_instances": 3,
      "instance_type": "basic",
      "rollout_step_percentage": [25, 50, 100],
      "rollout_active_grace_period": 30,
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LFMS_WEB",
        "class_name": "LfmsWebContainer",
      },
    ],
  },
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true,
    },
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LfmsWebContainer"],
    },
  ],
  "observability": {
    "enabled": true,
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "vars": {
    "NODE_ENV": "production",
    "PORT": "3000",
    "SHUTDOWN_TIMEOUT_MS": "30000",
    "DB_POOL_CONNECTION_LIMIT": "5",
    "DB_POOL_QUEUE_LIMIT": "50",
    "CONTAINER_INSTANCE_COUNT": "3",
    "BASE_DOMAIN": "apiseg.com",
    "ALLOWED_TENANT_ORIGINS": "https://apiseg.com,https://www.apiseg.com,https://admin.apiseg.com,https://auth.apiseg.com",
    "CSP_SCRIPT_ORIGINS": "https://maps.googleapis.com,https://maps.gstatic.com",
    "CSP_CONNECT_ORIGINS": "https://maps.googleapis.com,https://maps.gstatic.com",
    "CSP_IMAGE_ORIGINS": "https://maps.googleapis.com,https://maps.gstatic.com,https://streetviewpixels-pa.googleapis.com,https://lh3.googleusercontent.com",
    "VITE_APP_TITLE": "Livestock Farm Management System",
    "VITE_DEFAULT_DESIGN": "old",
    "VITE_ENABLE_LOCAL_DEV_AUTH": "0",
    "VITE_SUPPORT_EMAIL": "support@apiseg.com",
    "LOG_LEVEL": "info",
    "SMTP_FROM": "noreply@apiseg.com",
  },
  "secrets": {
    "required": [
      "DATABASE_URL",
      "INTERNAL_API_SECRET",
      "JWT_SECRET",
      "METRICS_BEARER_TOKEN",
      "OAUTH_STATE_SECRET",
      "SESSION_PEPPER",
    ],
  },
  "env": {
    "": {
      "name": "lfms",
    },
    "staging": {
      "name": "lfms-staging",
      "workers_dev": false,
      "assets": {
        "directory": "./dist/cloudflare-assets",
        "binding": "ASSETS",
        "html_handling": "none",
        "not_found_handling": "none",
        "run_worker_first": true,
      },
      "routes": [
        {
          "pattern": "staging.apiseg.com/*",
          "zone_name": "apiseg.com",
        },
        {
          "pattern": "*.staging.apiseg.com/*",
          "zone_name": "apiseg.com",
        },
      ],
      "containers": [
        {
          "class_name": "LfmsWebContainer",
          "image": "./Dockerfile",
          "max_instances": 1,
          "instance_type": "basic",
          "rollout_step_percentage": [100],
          "rollout_active_grace_period": 30,
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "LFMS_WEB",
            "class_name": "LfmsWebContainer",
          },
        ],
      },
      "send_email": [
        {
          "name": "EMAIL",
          "remote": true,
        },
      ],
      "observability": {
        "enabled": true,
      },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA",
      },
      "vars": {
        "NODE_ENV": "production",
        "PORT": "3000",
        "SHUTDOWN_TIMEOUT_MS": "30000",
        "DB_POOL_CONNECTION_LIMIT": "3",
        "DB_POOL_QUEUE_LIMIT": "25",
        "CONTAINER_INSTANCE_COUNT": "1",
        "BASE_DOMAIN": "staging.apiseg.com",
        "ALLOWED_TENANT_ORIGINS": "https://staging.apiseg.com,https://www.staging.apiseg.com,https://admin.staging.apiseg.com,https://auth.staging.apiseg.com",
        "CSP_SCRIPT_ORIGINS": "https://maps.googleapis.com,https://maps.gstatic.com",
        "CSP_CONNECT_ORIGINS": "https://maps.googleapis.com,https://maps.gstatic.com",
        "CSP_IMAGE_ORIGINS": "https://maps.googleapis.com,https://maps.gstatic.com,https://streetviewpixels-pa.googleapis.com,https://lh3.googleusercontent.com",
        "VITE_APP_TITLE": "LFMS Staging",
        "VITE_DEFAULT_DESIGN": "old",
        "VITE_ENABLE_LOCAL_DEV_AUTH": "0",
        "VITE_SUPPORT_EMAIL": "support@apiseg.com",
        "LOG_LEVEL": "info",
        "SMTP_FROM": "noreply@apiseg.com",
      },
      "secrets": {
        "required": [
          "DATABASE_URL",
          "INTERNAL_API_SECRET",
          "JWT_SECRET",
          "METRICS_BEARER_TOKEN",
          "OAUTH_STATE_SECRET",
          "SESSION_PEPPER",
        ],
      },
    },
  },
}
